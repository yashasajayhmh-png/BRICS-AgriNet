{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile with role and country sovereignty affiliation",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 120 },
        "email": { "type": "string", "maxLength": 160 },
        "role": { "type": "string", "enum": ["farmer", "extension_officer", "fpo_manager", "research_admin", "auditor", "admin", "researcher"] },
        "country": { "type": "string", "maxLength": 80 },
        "farmLocation": { "type": "string", "maxLength": 160 },
        "cropFocus": { "type": "string", "maxLength": 80 },
        "language": { "type": "string", "maxLength": 40 },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "name", "email", "role", "country", "createdAt"]
    },
    "CropDiagnosis": {
      "title": "CropDiagnosis",
      "description": "Multispectral crop leaf disease diagnosis result",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "crop": { "type": "string", "maxLength": 80 },
        "disease": { "type": "string", "maxLength": 120 },
        "confidence": { "type": "number" },
        "severityLevel": { "type": "string", "maxLength": 40 },
        "pesticideRiskScore": { "type": "string", "maxLength": 60 },
        "bricsHarmonizedMRL": { "type": "string", "maxLength": 120 },
        "advisory": { "type": "string", "maxLength": 2000 },
        "imagePlaceholder": { "type": "string", "maxLength": 120 },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "userId", "crop", "disease", "confidence", "createdAt"]
    },
    "EscalatedTicket": {
      "title": "EscalatedTicket",
      "description": "Extension agronomist escalated ticket for field review",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "farmerName": { "type": "string", "maxLength": 120 },
        "farmerPhone": { "type": "string", "maxLength": 60 },
        "farmerId": { "type": "string", "maxLength": 128 },
        "country": { "type": "string", "maxLength": 80 },
        "flag": { "type": "string", "maxLength": 30 },
        "region": { "type": "string", "maxLength": 160 },
        "crop": { "type": "string", "maxLength": 80 },
        "photoUrl": { "type": "string", "maxLength": 300 },
        "aiSuggestedCondition": { "type": "string", "maxLength": 200 },
        "confidenceScore": { "type": "number" },
        "triageReason": { "type": "string", "maxLength": 1000 },
        "status": { "type": "string", "enum": ["PENDING_REVIEW", "IN_PROGRESS", "VERIFIED_BY_AGENT", "RESOLVED", "REJECTED"] },
        "urgency": { "type": "string", "enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"] },
        "assignedTo": { "type": "string", "maxLength": 120 },
        "agronomistNotes": { "type": "string", "maxLength": 2000 },
        "prescribedTreatment": { "type": "string", "maxLength": 2000 },
        "timestamp": { "type": "string", "maxLength": 80 },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "farmerName", "crop", "status"]
    },
    "PlotTelemetry": {
      "title": "PlotTelemetry",
      "description": "Live edge IoT telemetry and satellite crop health data for farm plots",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 120 },
        "country": { "type": "string", "maxLength": 80 },
        "flag": { "type": "string", "maxLength": 30 },
        "region": { "type": "string", "maxLength": 160 },
        "crop": { "type": "string", "maxLength": 80 },
        "soilType": { "type": "string", "maxLength": 120 },
        "soilPH": { "type": "number" },
        "nitrogen": { "type": "number" },
        "phosphorus": { "type": "number" },
        "potassium": { "type": "number" },
        "organicCarbonPercent": { "type": "number" },
        "soilMoisture": { "type": "number" },
        "rainfallForecast7d": { "type": "number" },
        "humidityPercent": { "type": "number" },
        "ndviCurrent": { "type": "number" },
        "historicalYieldAvg": { "type": "number" }
      },
      "required": ["id", "name", "country", "crop", "soilMoisture"]
    },
    "OutbreakReport": {
      "title": "OutbreakReport",
      "description": "Sentinel field outbreak report for transboundary biosecurity",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "country": { "type": "string", "maxLength": 80 },
        "flag": { "type": "string", "maxLength": 30 },
        "region": { "type": "string", "maxLength": 160 },
        "crop": { "type": "string", "maxLength": 80 },
        "pestDisease": { "type": "string", "maxLength": 160 },
        "severity": { "type": "string", "enum": ["Low", "Moderate", "Severe", "Critical", "MODERATE", "HIGH"] },
        "sporeDensityIndex": { "type": "number" },
        "distanceToBorderKm": { "type": "number" },
        "neighboringCountry": { "type": "string", "maxLength": 120 },
        "verifiedBy": { "type": "string", "maxLength": 120 },
        "date": { "type": "string", "maxLength": 80 },
        "reportedAt": { "type": "string" }
      },
      "required": ["id", "country", "crop", "pestDisease", "severity"]
    },
    "FederatedRound": {
      "title": "FederatedRound",
      "description": "Federated learning coordinator aggregation round log",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "roundNumber": { "type": "number" },
        "globalAccuracy": { "type": "number" },
        "nonIIDDivergence": { "type": "number" },
        "epsilonUsed": { "type": "number" },
        "aggregationMethod": { "type": "string", "maxLength": 80 },
        "coordinatorNotes": { "type": "string", "maxLength": 2000 },
        "sovereignCertificate": { "type": "string", "maxLength": 200 },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "roundNumber", "globalAccuracy", "epsilonUsed", "sovereignCertificate"]
    },
    "TestConnection": {
      "title": "TestConnection",
      "description": "Test doc to verify server connection readiness",
      "type": "object",
      "properties": {
        "status": { "type": "string", "maxLength": 40 }
      },
      "required": ["status"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User sovereign identity profiles"
    },
    "/diagnoses/{diagnosisId}": {
      "schema": "CropDiagnosis",
      "description": "Multispectral crop leaf disease diagnoses"
    },
    "/tickets/{ticketId}": {
      "schema": "EscalatedTicket",
      "description": "Extension agronomist review tickets"
    },
    "/plots/{plotId}": {
      "schema": "PlotTelemetry",
      "description": "BRICS farm plot IoT and remote sensing data"
    },
    "/outbreaks/{outbreakId}": {
      "schema": "OutbreakReport",
      "description": "Transboundary biosecurity alert reports"
    },
    "/federated_rounds/{roundId}": {
      "schema": "FederatedRound",
      "description": "DP-FedAvg privacy-preserving federated rounds"
    },
    "/test/{testId}": {
      "schema": "TestConnection",
      "description": "Test connection ping document"
    }
  }
}
